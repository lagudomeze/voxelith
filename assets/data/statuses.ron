    // =====================================================================
    //  ToME4 增益族
    //
    //  ToME4 的增益有两种模式：`mode = "sustained"`（开关 + 每回合耗资源）
    //  与定时 buff。引擎只有**定时状态**，所以：
    //  - 定时 buff：一对一（`direct`）；
    //  - sustain：用一个长时状态 + `on_tick` 扣资源近似，缺"主动关闭 /
    //    资源耗尽自动关闭"（`approx`）；
    //  - `mode = "passive"`（常驻被动）：**做不到**，没有无时长的状态。
    // =====================================================================
    (
        // ToME4 `Thick Skin`（被动抗性）—— 用长时状态近似常驻。
        id: "thick_skin",
        name: "厚皮",
        default_duration: 30.0,
        stacking: Refresh,
        modifiers: [(stat: "armor", delta: Literal(6.0))],
        blocks_tags: [],
        on_apply:  [Log(text: "你的皮肤变得坚硬。")],
        on_tick:   [],
        on_expire: [],
        on_remove: [],
    ),
    (
        // ToME4 `EFF_REGENERATION` / `Vitality`：每秒回血。
