    // =====================================================================
    //  ToME4 硬控族（**只读数据**能实现的最强控制）
    //
    //  在 ToME4 里，"眩晕 / 定身 / 沉默 / 缴械 / 沉睡"是五套各自独立的免疫与
    //  抗性，还分 physical / mental / magical 三类 power 判定。这个引擎只有
    //  一件事：`blocks_tags` 挡掉 7 个技能标签之一。
    //
    //  所以控制效果在数据侧的表达力 = "让对手的某一类技能不可用"。
    //  这是**真的能打出来**的（技能栏会变空 / AI 选不出招），不是装饰。
    //  代价：没有免疫、没有抗性判定、没有"睡了就醒"的触发。
    // =====================================================================
    (
        // ToME4 `dazed`：比 stun 轻，被打一下就醒，但同样动不了。
        id: "dazed",
        name: "晕眩",
        default_duration: 3.0,
        stacking: Refresh,
        modifiers: [(stat: "defense", delta: Literal(-4.0))],
        blocks_tags: [MOVEMENT, COUNTER],
        on_apply:  [Log(text: "目标被打得晕头转向。")],
        on_tick:   [],
        on_expire: [],
        on_remove: [],
    ),
    (
        // ToME4 `confused`：施法/技能失败。这里落到"封法术与瞬发"。
        id: "confused",
        name: "混乱",
        default_duration: 4.0,
        stacking: Refresh,
        modifiers: [(stat: "cunning", delta: Literal(-5.0))],
        blocks_tags: [SPELL, INSTANT],
