    // =====================================================================
    //  ToME4 持续伤害族
    //
    //  引擎的 `on_tick` **固定每秒结算一次**（`tick_statuses` 里的 1.0 秒累加器），
    //  没有"每回合"的概念，也没有"总伤害 N 点分摊到 D 秒"的原语。
    //  所以这里的每跳伤害是**写死的常量**：ToME4 里"随天赋等级成长"的那部分
    //  在 DoT 上完全丢失（总伤害只能靠延长 duration 拉）。
    // =====================================================================
    (
        // ToME4 `EFF_CUT` / `EFF_DEEP_WOUND` 的合并表达。`Stack(max: 5)` 对应
        // ToME4 的"多层伤口各自计时"。
        id: "bleeding",
        name: "流血",
        default_duration: 5.0,
        stacking: Stack(max: 5),
        modifiers: [],
        blocks_tags: [],
        on_apply:  [Log(text: "伤口开始淌血。")],
        on_tick:   [ModifyResource(pool: "hp", delta: Neg(Literal(4.0)), who: Target)],
        on_expire: [],
        on_remove: [],
    ),
    (
        // ToME4 `DamageType.FIREBURN`：法师的持续火焰。
        id: "burning_tome",
        name: "燃烧",
        default_duration: 4.0,
        stacking: Replace,
        modifiers: [],
        blocks_tags: [],
        on_apply:  [Log(text: "烈焰缠上了目标。")],
        on_tick:   [ModifyResource(pool: "hp", delta: Neg(Literal(8.0)), who: Target)],
        on_expire: [],
        on_remove: [],
    ),
    (
        // ToME4 的毒（`EFF_POISONED` / `EFF_NUMBING_POISON`），叠 4 层。
        id: "poisoned",
        name: "剧毒",
        default_duration: 6.0,
