        costs: [(pool: "equilibrium", amount: 15.0)],
        targeting: SelfOnly,
        effects: [
            ApplyStatus(status: "providence", duration: Literal(12.0), who: Caster),
        ],
    ),
    (
        // [direct] ToME4 `Temporal Form`（prodigy）：定时强大 buff（`direct` 的一类）。
        id: "temporal_form",
        roles: [Player],
        name: "时间形态",
        tags: [SPELL, GUARD, INSTANT],
        duration: 12.0,
        requirements: [
            NoActiveAction,
            Resource(pool: "mana", min: 40.0),
        ],
        costs: [(pool: "mana", amount: 40.0)],
        targeting: SelfOnly,
        effects: [
            ApplyStatus(status: "temporal_form", duration: Literal(10.0), who: Caster),
        ],
    ),
    (
        // [approx] ToME4 `Gloom`（sustain 光环）。
        id: "gloom",
        roles: [Player],
        name: "幽暗",
        tags: [GUARD],
        duration: 3.0,
        requirements: [
            NoActiveAction,
            NotInStatus("gloom"),
            Resource(pool: "stamina", min: 18.0),
        ],
        costs: [(pool: "stamina", amount: 18.0)],
        targeting: SelfOnly,
        effects: [
            ApplyStatus(status: "gloom", duration: Literal(12.0), who: Caster),
        ],
    ),
    (
        // [direct] ToME4 `Coup de Grace` / 处决类：低血线斩杀。
        // 这是 `Conditional{ResourceBelow}` 的**忠实**用法（引擎真的能读池占比）。
        id: "coup_de_grace",
        roles: [Player],
        name: "致命一击",
        tags: [ATTACK],
        duration: 4.0,
        requirements: [
            NoActiveAction,
            Resource(pool: "stamina", min: 16.0),
        ],
        costs: [(pool: "stamina", amount: 16.0)],
        targeting: CurrentSelection,
        effects: [
            Conditional(
                cond: ResourceBelow(pool: "hp", ratio: 0.25),
                then: Sequence([
                    ModifyResource(pool: "hp", delta: Neg(Literal(60.0)), who: Target),
                    Log(text: "你抓住了那一瞬，一刀毙命！"),
                ]),
                else_: Contest((
                    attacker: Sum([CasterStat("accuracy"), Literal(4.0)]),
                    defender: TargetStat("defense"),
                    formula: Difference,
                    threshold: 0.0,
                    crit_margin: 0.0,
                    outcomes: [
                        (Success, [
                            ModifyResource(pool: "hp", delta: Neg(Literal(18.0)), who: Target),
                            Log(text: "一刀砍进了肩膀。"),
                        ]),
                        (Fail, [Log(text: "处决落空了。")]),
                    ],
                )),
            ),
        ],
    ),
    (
        // [approx] ToME4 `Counter Shot` / `Riposte` 类"反应式追击"：钩子做不到，
        // 但引擎有 `InStatus` 门控 + `SpawnAction`，可以做成**手动**的连携：
        // 刚出过暴击（`just_crit`）时，追加一次射击。
        id: "counter_shot",
        roles: [Player],
        name: "反击射击",
        tags: [ATTACK, COUNTER, INSTANT],
        duration: 0.0,
        requirements: [
            NoActiveAction,
            InStatus("just_crit"),
            Resource(pool: "stamina", min: 8.0),
        ],
        costs: [(pool: "stamina", amount: 8.0)],
        targeting: CurrentSelection,
        effects: [
            // `SpawnAction` 让"追加一个技能"成为数据可配的事（引擎唯一的连锁原语）。
            SpawnAction(skill: "steady_shot", who: Caster),
            RemoveStatus(status: "just_crit", who: Caster),
            Log(text: "你顺着刚才那一下补了一箭。"),
        ],
    ),
]
