    (
        // [direct] ToME4 `Second Wind`：立刻回体力。
        //
        // 注意：这里**不能**用 `ResourceBelow` —— 它是 `Effect` 内部的
        // `ConditionRon`（`Conditional{cond}` 才收它），技能前置需求那一栏
        // （`RequirementRon`）只认 Resource / HasThreat / NoActiveAction /
        // InStatus / NotInStatus / OffCooldown / TargetAlive / TargetIsEnemy /
        // CasterHasTag 这九种。加载期会直接报 "Unexpected variant"。
        id: "second_wind",
        roles: [Player],
        name: "第二口气",
        tags: [INSTANT, HEAL],
        duration: 0.0,
        requirements: [
            NoActiveAction,
            NotInStatus("vitality"),
