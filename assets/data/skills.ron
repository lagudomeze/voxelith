                    ]),
                    (Fail, [Log(text: "冲撞落空了。")]),
                ],
            )),
        ],
    ),
    (
        // [approx] ToME4 `Repulsion`：把周围敌人推开并击晕。位移做不到 → 只留"晕眩 + 削闪避"。
        id: "shield_repulsion",
