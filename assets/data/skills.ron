    // ---- 下面两个是**引擎分支的内容用例** ----
    (
        // `Formula::RollUnder` 的**唯一内容用例**。
        //
        // 语义（见 `contest.rs`）：`roll = attacker * rand()`，
        // `roll < threshold` 成功、`roll < threshold * 0.05` 是暴击、
        // `roll >= attacker` 是**失手**。
        //
        // 所以这里的读法是：
        // - `attacker` 是**掷骰的上界**（越大越容易落在 threshold 以下）；
        // - `threshold` 是**成功率的目标值**（不是百分比）。
        //
        // 盾击的取舍：力量 6 的哥布林掷出 [0,16)，threshold 5 ⇒ 约 31% 眩晕；
        // 力量高的角色打同一个目标更容易眩晕 —— 这正是"用属性换控制"的表达。
        id: "shield_bash",
        roles: [Player],
        name: "盾击",
        icon: "shield_bash.png",
        tags: [ATTACK],
        duration: 1.2,
        requirements: [
            Resource(pool: "action", min: 1.0),
            NoActiveAction,
        ],
        costs: [(pool: "action", amount: 1.0)],
        targeting: CurrentSelection,
        effects: [
            Contest((
                attacker: Sum([CasterStat("strength"), Literal(10.0)]),
                defender: TargetStat("armor"),
                formula: RollUnder,
                threshold: 5.0,
                crit_margin: 0.0,
                outcomes: [
                    (Crit, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(6.0)), who: Target),
                        ApplyStatus(status: "stunned", duration: Literal(2.0), who: Target),
                        Log(text: "盾牌正中面门，对手懵了！"),
                    ]),
                    (Success, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(4.0)), who: Target),
                        ApplyStatus(status: "stunned", duration: Literal(1.0), who: Target),
                        Log(text: "盾击命中，对手踉跄了一下。"),
                    ]),
                    (Fumble, [Log(text: "盾牌脱手了！")]),
                    (Fail, [Log(text: "盾击被卸开了。")]),
                ],
            )),
        ],
    ),
    (
        // `Stacking::Replace`（灼烧）与 `Stacking::Ignore`（踉跄）的用例。
        //
        // 一次施加同时挂两种**不同叠加规则**的状态，这样"叠加规则确实按
        // 每个状态自己的配置走"这件事有了真实数据可测
        // （而不是只靠 `status.rs` 的单测）。
        id: "cinder_burst",
        roles: [Player],
        name: "余烬爆",
        icon: "cinder_burst.png",
        tags: [SPELL, ATTACK],
        duration: 1.4,
        requirements: [
            Resource(pool: "mana", min: 8.0),
            NoActiveAction,
        ],
        costs: [(pool: "mana", amount: 8.0)],
        targeting: CurrentSelection,
        effects: [
            Contest((
                attacker: Sum([CasterStat("agility"), Literal(8.0)]),
                defender: TargetStat("armor"),
                formula: Difference,
                threshold: 0.0,
                crit_margin: 4.0,
                outcomes: [
                    (Success, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(5.0)), who: Target),
                        // `Replace`：再中一次是"新的 1 层"，不是叠到 2 层。
                        ApplyStatus(status: "burning", duration: Literal(4.0), who: Target),
                        // `Ignore`：已经踉跄时再中**无效**（时长不会延长）。
                        ApplyStatus(status: "staggered", duration: Literal(3.0), who: Target),
                        Log(text: "余烬在目标身上炸开！"),
                    ]),
                    (Crit, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(12.0)), who: Target),
                        ApplyStatus(status: "burning", duration: Literal(4.0), who: Target),
                        ApplyStatus(status: "staggered", duration: Literal(3.0), who: Target),
                        Log(text: "余烬爆裂，目标站都站不稳！"),
                    ]),
                    (Fail, [Log(text: "余烬散在了空气里。")]),
                ],
            )),
        ],
    ),
    (
        // **中立单位的技能**（`Faction::Neutral` 的配套内容）。
        //
        // 为什么它必须存在：中立的游商**不能有能打到人的技能**，
        // 所以它的 AI 表里只能放这种技能。`targeting: SelfOnly` 是刻意的 ——
        // 就算将来有人把它改成 `CurrentSelection`，
        // `requirements` 里的 `TargetIsEnemy` 也会让它在**任何**目标上不成立
        // （`Neutral` 对谁都不敌对），于是技能永远不可用，而不是"突然开始打人"。
        //
        // 双重保险：目标选择 + 可用性门控。这类"不该发生的攻击"靠一层是拦不住的。
        id: "merchant_cower",
        roles: [Monster],
        name: "缩成一团",
        icon: "cower.png",
        tags: [INSTANT],
        duration: 0.5,
        requirements: [
            NoActiveAction,
            TargetIsEnemy,
        ],
        costs: [],
        targeting: SelfOnly,
        effects: [
            Log(text: "游商缩起身子，护住了自己的货箱。"),
        ],
    ),

    // =====================================================================================
    //  ToME4 天赋移植名册
    //
    //  规则：**只改数据，不改 Rust**。下面每一条都是 ToME4 里真实存在的天赋，
    //  逐条翻译成这个引擎的 `Effect` 原语。翻译的**取舍**写在每条技能的注释里，
    //  完整矩阵（每条机制 → direct / approx / impossible，以及引擎缺口）见
    //  `assets/data/tome4-coverage.md`。
    //
    //  三条贯穿全篇的翻译约定（请务必先读）：
    //
    //  1. **天赋等级**：引擎没有天赋等级，用扮演"1..5 级"的属性 `level` 喂
    //     `Scale{input: CasterStat("level"), anchors: Talent}`。低阶天赋用它缩放，
    //     高阶天赋另外用 `Resource(pool: "stamina", min: N)` 当"点了几点"的门控。
    //  2. **冷却**：`SkillRon` **没有** cooldown 字段，引擎把冷却自动设成
    //     `duration.max(0.5)` 秒。所以这里的 `duration` 同时承担"释放耗时"与
    //     "冷却近似"两个角色：大招给大 duration（例如 8.0 = 8 秒冷却）。
    //     这是近似，不是等价 —— ToME4 的 `fixed_cooldown` 与减 CD 完全表达不了。
    //  3. **范围**：目标解析只有 4 种（SelfOnly / ThreatSource / CurrentSelection /
    //     NearestEnemy），**没有任何距离、方向、半径**。所以 ToME4 的 ball / cone /
    //     beam / radius 一律塌缩成"打一个目标"，并在这条技能的注释里标 `[approx]`。
    //     标 `[impossible]` 的机制（召唤 / 传送 / 位移 / 地形 / 常驻被动 / 事件钩子 /
    //     护盾吸收池 / 免疫 / 冷却操纵 / 随机数）**这里一条都不写** —— 写出来也是假的。
    // =====================================================================================

    // -------------------------------------------------------------------------------------
    //  technique/shield-offense（盾战系）
    // -------------------------------------------------------------------------------------
    (
        // [direct] ToME4 `Shield Pummel`：两次盾击，每次命中后有几率眩晕。
        // 翻译：Sequence 两次 Contest（引擎没有循环，次数写死）；眩晕按低概率的成功线表达。
        id: "shield_pummel",
        roles: [Player],
        name: "盾牌猛击",
        tags: [ATTACK],
        duration: 4.0,
        requirements: [
            NoActiveAction,
            Resource(pool: "stamina", min: 8.0),
        ],
        costs: [(pool: "stamina", amount: 8.0)],
        targeting: CurrentSelection,
        effects: [
            Contest((
                attacker: Sum([CasterStat("accuracy"), Literal(6.0)]),
                defender: TargetStat("defense"),
                formula: Difference,
                threshold: 0.0,
                crit_margin: 0.0,
                outcomes: [
                    (Success, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(10.0)), who: Target),
                        Log(text: "第一下盾击砸实了。"),
                    ]),
                    (Fail, [Log(text: "第一下被卸开了。")]),
                ],
            )),
            Contest((
                attacker: Sum([CasterStat("accuracy"), Literal(4.0)]),
                defender: TargetStat("defense"),
                formula: Difference,
                threshold: 4.0,
                crit_margin: 0.0,
                outcomes: [
                    (Success, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(10.0)), who: Target),
                        ApplyStatus(status: "stunned", duration: Literal(2.0), who: Target),
                        Log(text: "第二下正中面门，目标晕了。"),
                    ]),
                    (Fail, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(6.0)), who: Target),
                        Log(text: "第二下只擦到了。"),
                    ]),
                ],
            )),
        ],
    ),
    (
        // [direct] ToME4 `Shield Slam`：单次重击 + 击退。击退（位移）做不到，保留伤害与眩晕。
        id: "shield_slam",
        roles: [Player],
        name: "盾牌冲撞",
        tags: [ATTACK],
        duration: 5.0,
        requirements: [
