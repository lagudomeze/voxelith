    (
        // [approx] ToME4 `Bleeding Edge`（实际上在 dualweapon 树）：这里放在双手武器树做
        // "重击 + 深层伤口"的综合表达。ToME4 的"流血按已损失生命百分比"做不到 → 固定跳伤。
        id: "bleeding_edge",
        roles: [Player],
        name: "血刃",
        tags: [ATTACK],
        duration: 5.0,
        requirements: [
            NoActiveAction,
            Resource(pool: "stamina", min: 14.0),
        ],
        costs: [(pool: "stamina", amount: 14.0)],
        targeting: CurrentSelection,
        effects: [
            Contest((
                attacker: Sum([CasterStat("strength"), Literal(4.0)]),
                defender: TargetStat("armor"),
                formula: Difference,
                threshold: 0.0,
                crit_margin: 8.0,
                outcomes: [
                    (Crit, [
                        ModifyResource(pool: "hp", delta: Neg(Literal(22.0)), who: Target),
