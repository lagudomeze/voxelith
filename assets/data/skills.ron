        costs: [(pool: "action", amount: 1.0)],
        targeting: CurrentSelection,
        effects: [
            Contest((
                attacker: Sum([CasterStat("strength"), Literal(5.0)]),
                defender: TargetStat("armor"),
                formula: Difference,
                threshold: 0.0,
                crit_margin: 5.0,
                outcomes: [
                    (Success, [
                        ModifyResource(
                            pool: "hp",
                            delta: Neg(SkillPower),
                            who: Target,
                        ),
                        Log(text: "命中！"),
                    ]),
                    (Crit, [
                        ModifyResource(
                            pool: "hp",
                            delta: Neg(Mul(SkillPower, Literal(1.5))),
                            who: Target,
                        ),
                        Log(text: "重击！"),
                    ]),
                    (Fail, [Log(text: "被挡下了。")]),
                ],
            )),
        ],
    ),
